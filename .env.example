# Kinetic Feed - Environment Configuration Template
# Copy this file to .env and fill in your Gemini API key

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Model Name
GEMINI_MODEL="gemini-3.6-flash"

# Default Target Comments Per Run
TARGET_COMMENTS=6

# Delay Range (in seconds) Between Comment Submissions
MIN_DELAY=3
MAX_DELAY=6

# Local Dashboard Server Port
DASHBOARD_PORT=5050
